# URL de l'API backend NestJS (prefixe /api inclus).
# Le backend tourne par defaut sur le port 4000.
# Penser a ajouter http://localhost:5181 a CORS_ORIGIN dans le .env du backend.
VITE_API_URL=http://localhost:4000/api

# URL du site public (lien « Voir le site » dans la barre laterale).
VITE_SITE_URL=http://localhost:5180

# true  -> couche de donnees simulee en memoire (aucun backend requis)
# false -> requetes reelles vers VITE_API_URL
VITE_USE_MOCKS=false
